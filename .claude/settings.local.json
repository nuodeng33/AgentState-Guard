{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "WebSearch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(python3 -m venv .venv)",
      "Bash(.venv/bin/python -m pip install -e .)",
      "Bash(.venv/bin/python -m pip install -e *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m ruff *)",
      "Bash(.venv/bin/python -m mypy *)",
      "Bash(.venv/bin/python -m build *)",
      "Bash(.venv/bin/python -m agentguard *)",
      "Bash(npm ci)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm run e2e *)",
      "Bash(npm audit --json)",
      "Bash(npx playwright test *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:packaging.python.org)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:npmjs.com)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git restore .*)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git commit --amend *)",
      "Bash(git config --global *)",
      "Bash(git -c *)",
      "Bash(pip install --user *)",
      "Bash(pip install -g *)",
      "Bash(python3 -m pip install --user *)",
      "Bash(sudo *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dnf *)",
      "Bash(yum *)",
      "Bash(pacman *)",
      "Bash(npm publish *)",
      "Bash(npm unpublish *)",
      "Bash(npm deprecate *)",
      "Bash(npm owner *)",
      "Bash(npm access *)",
      "Bash(npm token *)",
      "Bash(npm profile *)",
      "Bash(npm login *)",
      "Bash(npm logout *)",
      "Bash(npm config set *)",
      "Bash(npm install -g *)",
      "Bash(npm uninstall -g *)",
      "Bash(npm exec *)",
      "Bash(npx --yes *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.agentguard/**)",
      "Read(./**/*credential*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.agentguard/**)",
      "Edit(./.git/**)",
      "Edit(./**/*credential*)",
      "Edit(./**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/projects/**)",
      "Read(/etc/**)",
      "Read(/usr/**)",
      "Read(/var/run/docker.sock)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.git-credentials)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/var/run/docker.sock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/skills/strategic-compact/suggest-compact.js" }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "node ~/.claude/skills/strategic-compact/suggest-compact.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/retry_guard.py\" pre Bash \"$CLAUDE_COMMAND\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/retry_guard.py\" post Bash \"$CLAUDE_COMMAND\" \"$CLAUDE_EXIT_CODE\"" }
        ]
      }
    ]
  }
}
