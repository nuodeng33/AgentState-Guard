{
  "productName": "AgentState Guard",
  "version": "0.9.0",
  "identifier": "com.agentstate-guard.desktop",
  "build": {
    "frontendDist": "../../agentguard/web_static",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": "cd .. && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentState Guard",
        "width": 960,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
